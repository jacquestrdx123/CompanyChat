# The Laravel API in backend/ (php artisan serve, or your Herd/Forge URL).
NUXT_PUBLIC_API_URL=http://localhost:8000

# Reverb websockets: the same values as REVERB_APP_KEY / REVERB_HOST / REVERB_PORT / REVERB_SCHEME in backend/.env.
NUXT_PUBLIC_REVERB_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# Public Web Push (VAPID) key for background notifications (php artisan chat:vapid-keys). Leave empty to hide the option.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
